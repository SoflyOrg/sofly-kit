{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "@sofly/kit next (apps/web)",
	"extends": "./base.json",
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"jsx": "preserve",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"verbatimModuleSyntax": false,
		"allowJs": true,
		"incremental": true,
		"noEmit": true,
		"plugins": [{ "name": "next" }]
	}
}
